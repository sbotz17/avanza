# Template per lo sviluppo locale con gli emulatori Firebase.
# NON committare mai il file .env.local con il vero secret.
#
# Per usarlo in locale:
#   cp functions/.env.local.example functions/.env.local
#   Poi sostituisci il valore di GITHUB_WEBHOOK_SECRET con un secret di test.
#
# Il vero secret di produzione va in Firebase Secret Manager:
#   firebase secrets:set GITHUB_WEBHOOK_SECRET
#
# Non usare mai il secret di produzione in locale.
# Il file .env.local è escluso da Git (vedi .gitignore).

GITHUB_WEBHOOK_SECRET=inserisci-qui-un-secret-di-test-locale
