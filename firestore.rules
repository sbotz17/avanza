rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Accesso cliente: il codice cliente è l'ID del documento. Si può leggere
    // un documento solo conoscendo il codice (get), mai elencare i codici.
    match /clientAccess/{code} {
      allow get: if true;
      allow list: if false;
      allow create: if request.auth != null && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.ownerId == request.auth.uid;
    }

    match /projects/{projectId} {
      // Un progetto si apre solo conoscendo il suo ID (non indovinabile, preso
      // dal codice cliente). L'elenco è consentito solo al proprietario:
      // nessuno può enumerare i progetti degli altri.
      allow get: if true;
      allow list: if request.auth != null && resource.data.ownerId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.ownerId == request.auth.uid;

      // Task: stato e dettaglio leggibili dal cliente (conosce l'ID progetto),
      // scrittura solo del proprietario. Qui NON ci sono costi né tariffe.
      match /tasks/{taskId} {
        allow read: if true;
        allow write: if request.auth != null &&
          get(/databases/$(database)/documents/projects/$(projectId)).data.ownerId == request.auth.uid;
      }

      // Stime, ore reali e tariffe del task: solo admin (proprietario)
      match /taskCosts/{taskId} {
        allow read, write: if request.auth != null &&
          get(/databases/$(database)/documents/projects/$(projectId)).data.ownerId == request.auth.uid;
      }

      // Registro ore: solo admin (contiene tariffe e costi)
      match /timeEntries/{entryId} {
        allow read, write: if request.auth != null &&
          get(/databases/$(database)/documents/projects/$(projectId)).data.ownerId == request.auth.uid;
      }
    }

    // Membri della squadra con tariffe: solo admin
    match /teamMembers/{memberId} {
      allow read: if request.auth != null && resource.data.ownerId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.ownerId == request.auth.uid;
    }
  }
}
