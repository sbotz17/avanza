rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Projects: owner can read/write; anyone can read by clientCode (queried client-side)
    match /projects/{projectId} {
      allow read: if request.auth != null && resource.data.ownerId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.ownerId == request.auth.uid;

      // Allow unauthenticated read for client access (by clientCode)
      // Client queries filter by clientCode, so expose read for public projects
      allow read: if resource.data.keys().hasAll(['clientCode']);

      // Tasks subcollection: same owner access + unauthenticated read (client view)
      match /tasks/{taskId} {
        allow read: if true; // clients access tasks read-only with projectId
        allow write: if request.auth != null &&
          get(/databases/$(database)/documents/projects/$(projectId)).data.ownerId == request.auth.uid;
      }

      // Registro ore: solo il proprietario del progetto (contiene tariffe e costi)
      match /timeEntries/{entryId} {
        allow read, write: if request.auth != null &&
          get(/databases/$(database)/documents/projects/$(projectId)).data.ownerId == request.auth.uid;
      }
    }

    // Membri della squadra (agenti e persone) con tariffe: solo il proprietario
    match /teamMembers/{memberId} {
      allow read: if request.auth != null && resource.data.ownerId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.ownerId == request.auth.uid;
    }
  }
}
