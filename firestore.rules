rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Admin = utente con users/{uid}.role == 'admin' (assegnato solo da console/script)
    function isAdmin() {
      return signedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isProjectOwner(projectId) {
      return signedIn() &&
        get(/databases/$(database)/documents/projects/$(projectId)).data.ownerId == request.auth.uid;
    }

    // Il cliente vede un progetto solo dopo averlo collegato al suo account con il codice
    function isLinkedClient(projectId) {
      return signedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)/clientProjects/$(projectId));
    }

    // Profilo utente: ognuno legge solo il proprio. Un nuovo utente nasce sempre
    // come cliente e non può cambiare il proprio ruolo.
    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn() && request.auth.uid == uid && request.resource.data.role == 'client';
      allow update, delete: if false;

      // Progetti collegati al cliente tramite codice. Il collegamento è valido solo
      // se il codice esiste ed è quello di quel progetto.
      match /clientProjects/{projectId} {
        allow read: if signedIn() && request.auth.uid == uid;
        allow create: if signedIn() && request.auth.uid == uid &&
          get(/databases/$(database)/documents/clientAccess/$(request.resource.data.code)).data.projectId == projectId;
        allow delete: if signedIn() && request.auth.uid == uid;
        allow update: if false;
      }
    }

    // Codice progetto -> progetto. Solo lettura per ID da utenti autenticati, mai elenco.
    match /clientAccess/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if isAdmin() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.ownerId == request.auth.uid;
    }

    match /projects/{projectId} {
      allow get: if signedIn() && (resource.data.ownerId == request.auth.uid || isLinkedClient(projectId));
      allow list: if signedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isAdmin() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.ownerId == request.auth.uid;

      // Task: stato e dettaglio per proprietario e clienti collegati. Nessun costo qui.
      match /tasks/{taskId} {
        allow read: if isProjectOwner(projectId) || isLinkedClient(projectId);
        allow write: if isProjectOwner(projectId);

        // Chat dell'admin con la squadra sul task: SOLO admin proprietario, mai i clienti.
        // Il client può solo creare domande ('admin' / 'domanda'); le risposte
        // della squadra le scrive solo l'Admin SDK (script), che non passa dalle regole.
        // Nessun update né delete dal client.
        match /chat/{messageId} {
          allow read: if isAdmin() && isProjectOwner(projectId);
          allow create: if isAdmin() && isProjectOwner(projectId) &&
            request.resource.data.keys().hasOnly(['from', 'text', 'authorUid', 'authorName', 'createdAt', 'kind']) &&
            request.resource.data.from == 'admin' &&
            request.resource.data.kind == 'domanda' &&
            request.resource.data.authorUid == request.auth.uid &&
            request.resource.data.authorName is string &&
            request.resource.data.authorName.size() <= 200 &&
            request.resource.data.text is string &&
            request.resource.data.text.size() >= 1 &&
            request.resource.data.text.size() <= 2000 &&
            request.resource.data.createdAt == request.time;
          allow update, delete: if false;
        }
      }

      // Stime, ore reali e tariffe: solo admin (proprietario)
      match /taskCosts/{taskId} {
        allow read, write: if isProjectOwner(projectId);
      }

      // Registro ore: solo admin (contiene tariffe e costi)
      match /timeEntries/{entryId} {
        allow read, write: if isProjectOwner(projectId);
      }
    }

    // Membri della squadra con tariffe: solo admin
    match /teamMembers/{memberId} {
      allow read: if signedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isAdmin() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.ownerId == request.auth.uid;
    }
  }
}
